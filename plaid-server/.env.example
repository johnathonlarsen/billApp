PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_or_production_secret
PLAID_ENV=sandbox
PLAID_ITEM_LIMIT=10
# Link uses Transactions to auto-detect bill payments against manually entered bills.
# Free on Trial; monthly per-Item subscription if you upgrade to a paid plan.
ANDROID_PACKAGE_NAME=com.family.bankapp

# Required — server refuses to start without a secret (≥16 chars).
FAMILY_APP_API_SECRET=replace-with-long-random-secret

# Required explicit opt-in — this relay is deprecated; prefer Supabase Edge Functions.
ALLOW_DEPRECATED_PLAID_SERVER=true
